{
  "name": "ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:property": "vitest run --dir packages/core/src --testNamePattern=property",
    "guards": "node .github/checks/loc-budget.mjs && node .github/checks/purity.mjs && node .github/checks/fixture-privacy.mjs",
    "proof": "node scripts/run-proofs.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm guards && pnpm test",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fast-check": "^4.0.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  }
}
